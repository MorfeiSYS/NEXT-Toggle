                        <WrapPanel>
                            <RadioButton x:Name="NetStartKeepLast" Style="{StaticResource Segment}" GroupName="NetOnStart" Content="{x:Static loc:Resources.Settings_Option_KeepLastState}" Checked="NetOnStart_Changed" />
                            <RadioButton x:Name="NetStartOn" Style="{StaticResource Segment}" GroupName="NetOnStart" Content="{x:Static loc:Resources.Settings_Net_OnStart_Connected}" Checked="NetOnStart_Changed" />
                            <RadioButton x:Name="NetStartOff" Style="{StaticResource Segment}" GroupName="NetOnStart" Content="{x:Static loc:Resources.Settings_Net_OnStart_Disconnected}" Checked="NetOnStart_Changed" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Net_Devices_Title}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="NetDevAll" Style="{StaticResource Segment}" GroupName="NetDev" Content="{x:Static loc:Resources.Settings_Net_DevAll}" Checked="NetDevices_Changed" />
                                <RadioButton x:Name="NetDevSelected" Style="{StaticResource Segment}" GroupName="NetDev" Content="{x:Static loc:Resources.Settings_Option_OnlySelected}" Checked="NetDevices_Changed" />
                            </WrapPanel>
                            <StackPanel x:Name="NetListPanel" Margin="0,12,0,0">
                                <ItemsControl x:Name="NetList" />
                                <TextBlock x:Name="NoAdaptersText" Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Net_NoAdapters}" Visibility="Collapsed" />
                                <TextBlock x:Name="NetSelectNoneWarning" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Warning}" Visibility="Collapsed"
                                           Text="{x:Static loc:Resources.Settings_Net_NoSelectionWarning}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="NetEnforceBox" Style="{StaticResource ToggleSwitch}" Checked="NetEnforce_Changed" Unchecked="NetEnforce_Changed">
