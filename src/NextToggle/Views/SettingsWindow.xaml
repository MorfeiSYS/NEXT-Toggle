                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="NetOverlayBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_Net_Overlay_Title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Net_Overlay_Hint}" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="NetCornerPanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Option_BadgePosition}" Margin="0,0,0,8" />
                                <WrapPanel>
