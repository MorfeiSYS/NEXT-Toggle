                                    <TextBlock Text="{x:Static loc:Resources.Settings_Net_EnforceOff_Title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Net_EnforceOff_Hint}" />
