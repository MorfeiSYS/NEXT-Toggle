                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,12"
                               Text="{x:Static loc:Resources.Settings_Net_FooterHint}" />
                </StackPanel>
            </ScrollViewer>

            <!-- General -->
            <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static loc:Resources.Settings_Nav_General}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_Startup}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource ToggleSwitch}" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Tray_StartWithWindows}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_General_StartWithWindows_Hint}" />
                                </StackPanel>
                            </CheckBox>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="StartMinimizedBox" Style="{StaticResource ToggleSwitch}" Checked="Simple_Changed" Unchecked="Simple_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_General_StartMinimized_Title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_General_StartMinimized_Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_Appearance}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="Theme" Content="{x:Static loc:Resources.Settings_Option_MatchWindows}" Checked="Theme_Changed" />
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="Theme" Content="{x:Static loc:Resources.Settings_Option_Light}" Checked="Theme_Changed" />
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="Theme" Content="{x:Static loc:Resources.Settings_Option_Dark}" Checked="Theme_Changed" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{x:Static loc:Resources.Settings_General_ThemeLight_Hint}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Language_Section}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="LangSystem" Style="{StaticResource Segment}" GroupName="Language" Content="{x:Static loc:Resources.Language_MatchWindows}" Checked="Language_Changed" />
                                <RadioButton x:Name="LangEnglish" Style="{StaticResource Segment}" GroupName="Language" Content="{x:Static loc:Resources.Language_English}" Checked="Language_Changed" />
                                <RadioButton x:Name="LangRussian" Style="{StaticResource Segment}" GroupName="Language" Content="{x:Static loc:Resources.Language_Russian}" Checked="Language_Changed" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{x:Static loc:Resources.Language_RestartHint}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_Sound}" />
                    <Border Style="{StaticResource Card}">
                        <CheckBox x:Name="PlaySoundBox" Style="{StaticResource ToggleSwitch}" Checked="Simple_Changed" Unchecked="Simple_Changed">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Resources.Settings_General_PlaySound_Title}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_General_PlaySound_Hint}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- About -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static loc:Resources.Settings_Nav_About}" />
                    <Border Style="{StaticResource Card}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AboutIcon" Width="64" Height="64" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Resources.Common_BrandName}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="{x:Static loc:Resources.Settings_About_Tagline}" />
                                <TextBlock x:Name="HelperStatusText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                <TextBlock Margin="0,12,0,0">
                                    <Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/MorfeiSYS/NEXT-Toggle" RequestNavigate="Link_RequestNavigate">
                                        GitHub repository
                                    </Hyperlink>
                                    <Run Text="   ·   " Foreground="{DynamicResource TextSecondary}" />
                                    <Hyperlink Click="OpenSettingsFolder_Click">
                                        <Run Text="{x:Static loc:Resources.Settings_About_OpenSettingsFolder}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_Updates}" />
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource SubtleButton}" Content="{x:Static loc:Resources.Button_CheckAgain}" Click="CheckUpdates_Click" />
                                    <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Content="{x:Static loc:Resources.Button_UpdateNow}" Margin="12,0,4,4"
                                            Visibility="Collapsed" Click="UpdateNow_Click" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateStatus" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Text="{x:Static loc:Resources.SettingsDyn_Update_Checking}" />
                                    <TextBlock x:Name="UpdateDetail" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="UpdateProgress" Style="{StaticResource BrutalProgress}" Margin="0,14,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="ReleaseLinkText" Margin="0,10,0,0" Visibility="Collapsed">
                                <Hyperlink x:Name="ReleaseLink" RequestNavigate="Link_RequestNavigate" NavigateUri="https://github.com/MorfeiSYS/NEXT-Toggle/releases/latest">
                                    <Run x:Name="ReleaseLinkRun" Text="{x:Static loc:Resources.Settings_About_WhatsNew}" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Border>
</Window>
