                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_Shortcut}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <v:HotkeyRecorderBox x:Name="NetRecorder" Width="260" />
                                <Button Style="{StaticResource SubtleButton}" Content="{x:Static loc:Resources.Button_Reset}" Margin="8,0,0,0" Click="ResetNetHotkey_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="{x:Static loc:Resources.Settings_HotkeyRecorder_Hint}" />
                            <TextBlock x:Name="NetHotkeyWarning" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
