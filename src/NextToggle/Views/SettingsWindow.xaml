                        <StackPanel>
                            <CheckBox x:Name="NetNotifyBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_Net_Notify_Title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Net_Notify_Hint}" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="NetNotifyStylePanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Option_NotificationStyle}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="NetNotifyWindows" Style="{StaticResource Segment}" GroupName="NetNotifyStyle" Content="{x:Static loc:Resources.Settings_Option_WindowsNotification}" Checked="Alerts_Changed" />
