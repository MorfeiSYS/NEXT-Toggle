<Window x:Class="NextToggle.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NextToggle.Properties"
        xmlns:v="clr-namespace:NextToggle.Views"
        Title="{x:Static loc:Resources.Settings_Title}" Width="1105" Height="655" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Neubrutalism: our own title bar (Windows' can't be styled), a thick ink frame around everything. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Frame" BorderBrush="{DynamicResource Ink}" BorderThickness="2.5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Title bar ============ -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,0,2.5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="{x:Static loc:Resources.Settings_Caption_Minimize}">
                        <Path Data="M0,0 H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="{x:Static loc:Resources.Settings_Caption_Maximize}">
                        <Path x:Name="MaxGlyph" Data="M0.5,0.5 H11.5 V11.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="{x:Static loc:Resources.Settings_Caption_Close}" Margin="0,0,4,0">
                        <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="BrandIcon" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{x:Static loc:Resources.Common_BrandName}" FontFamily="Segoe UI Black, Segoe UI" FontWeight="Black" FontSize="15"
                               Foreground="{DynamicResource AccentText}" Margin="10,0,0,1" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,2.5,0">
            <DockPanel>
                <!-- live status -->
                <Border DockPanel.Dock="Top" Margin="12,16,16,14" Padding="12,10" CornerRadius="8" BorderThickness="2.5"
                        Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Ink}" Effect="{DynamicResource HardShadowSmall}">
                    <StackPanel>
                        <!-- DockPanel (not a horizontal StackPanel) so long status text wraps instead of being cut off -->
                        <DockPanel Margin="0,0,0,7">
                            <Ellipse x:Name="MicDot" DockPanel.Dock="Left" Width="11" Height="11" VerticalAlignment="Top" Margin="0,3,0,0"
                                     Stroke="{DynamicResource Ink}" StrokeThickness="2" />
                            <TextBlock x:Name="MicChip" Margin="9,0,0,0" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,7">
                            <Ellipse x:Name="CamDot" DockPanel.Dock="Left" Width="11" Height="11" VerticalAlignment="Top" Margin="0,3,0,0"
                                     Stroke="{DynamicResource Ink}" StrokeThickness="2" />
                            <TextBlock x:Name="CamChip" Margin="9,0,0,0" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel>
                            <Ellipse x:Name="NetDot" DockPanel.Dock="Left" Width="11" Height="11" VerticalAlignment="Top" Margin="0,3,0,0"
                                     Stroke="{DynamicResource Ink}" StrokeThickness="2" />
                            <TextBlock x:Name="NetChip" Margin="9,0,0,0" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" x:Name="SidebarVersion" Margin="22,0,0,14" Style="{StaticResource Hint}" FontWeight="SemiBold" />

                <StackPanel>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Content="{x:Static loc:Resources.Settings_Nav_Overview}" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static loc:Resources.Activity_Title}" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0" Padding="5,0,5,1" CornerRadius="4" VerticalAlignment="Center"
                                    BorderThickness="2" BorderBrush="{DynamicResource Ink}" Background="#C9B6FF">
                                <TextBlock Text="{x:Static loc:Resources.Common_Beta}" FontSize="9" FontWeight="Black" Foreground="#111111" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMic" Style="{StaticResource NavItem}" Content="{x:Static loc:Resources.ActivityDyn_DeviceName_Microphone}" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavCamera" Style="{StaticResource NavItem}" Content="{x:Static loc:Resources.ActivityDyn_DeviceName_Camera}" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavNetwork" Style="{StaticResource NavItem}" Content="{x:Static loc:Resources.Activity_Lane_Network}" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="{x:Static loc:Resources.Settings_Nav_General}" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static loc:Resources.Settings_Nav_About}" VerticalAlignment="Center" />
                            <!-- shown when a newer release is out -->
                            <Border x:Name="AboutUpdateBadge" Visibility="Collapsed" Margin="8,0,0,0" Padding="6,0,6,1" CornerRadius="4"
                                    BorderThickness="2" BorderBrush="{DynamicResource Ink}" Background="{DynamicResource LiveFill}">
                                <TextBlock Text="{x:Static loc:Resources.Activity_Badge_New}" FontSize="10" FontWeight="Black" Foreground="#111111" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Pages ============ -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- Overview -->
            <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static loc:Resources.Settings_Nav_Overview}" />
                    <!-- Right margin leaves room for the cards' hard shadow; the ScrollViewer clips anything past its edge. -->
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- microphone card -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0" Cursor="Hand" Tag="Microphone" MouseLeftButtonUp="OverviewCard_Click"
                                ToolTip="{x:Static loc:Resources.Settings_Overview_OpenMicPage}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Image x:Name="MicCardIcon" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static loc:Resources.ActivityDyn_DeviceName_Microphone}" FontSize="17" FontWeight="Bold" />
                                        <TextBlock x:Name="MicCardDevices" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" x:Name="MicCardButton" Style="{StaticResource AccentButton}"
                                        Margin="0,18,0,0" Click="MicCardButton_Click" />
                                <StackPanel Margin="0,20,0,0">
                                    <Border x:Name="MicStateBadge" HorizontalAlignment="Left" Padding="14,2,14,4" CornerRadius="6" BorderThickness="2.5"
                                            BorderBrush="{DynamicResource Ink}" Effect="{DynamicResource HardShadowSmall}">
                                        <TextBlock x:Name="MicCardState" FontFamily="Segoe UI Black, Segoe UI" FontSize="24" FontWeight="Black" Foreground="#111111" />
                                    </Border>
                                    <TextBlock x:Name="MicCardHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- camera card -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" Margin="0" Cursor="Hand" Tag="Camera" MouseLeftButtonUp="OverviewCard_Click"
                                ToolTip="{x:Static loc:Resources.Settings_Overview_OpenCamPage}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Image x:Name="CamCardIcon" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static loc:Resources.ActivityDyn_DeviceName_Camera}" FontSize="17" FontWeight="Bold" />
                                        <TextBlock x:Name="CamCardDevices" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" x:Name="CamCardButton" Style="{StaticResource AccentButton}"
                                        Margin="0,18,0,0" Click="CamCardButton_Click" />
                                <StackPanel Margin="0,20,0,0">
                                    <Border x:Name="CamStateBadge" HorizontalAlignment="Left" Padding="14,2,14,4" CornerRadius="6" BorderThickness="2.5"
                                            BorderBrush="{DynamicResource Ink}" Effect="{DynamicResource HardShadowSmall}">
                                        <TextBlock x:Name="CamCardState" FontFamily="Segoe UI Black, Segoe UI" FontSize="24" FontWeight="Black" Foreground="#111111" />
                                    </Border>
                                    <TextBlock x:Name="CamCardHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- network card (second row: three cards side by side get too narrow) -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,22,0,0" Cursor="Hand" Tag="Network" MouseLeftButtonUp="OverviewCard_Click"
                                ToolTip="{x:Static loc:Resources.Settings_Overview_OpenNetPage}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Image x:Name="NetCardIcon" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static loc:Resources.Activity_Lane_Network}" FontSize="17" FontWeight="Bold" />
                                        <TextBlock x:Name="NetCardDevices" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" x:Name="NetCardButton" Style="{StaticResource AccentButton}"
                                        Margin="0,18,0,0" Click="NetCardButton_Click" />
                                <StackPanel Margin="0,20,0,0">
                                    <Border x:Name="NetStateBadge" HorizontalAlignment="Left" Padding="14,2,14,4" CornerRadius="6" BorderThickness="2.5"
                                            BorderBrush="{DynamicResource Ink}" Effect="{DynamicResource HardShadowSmall}">
                                        <TextBlock x:Name="NetCardState" FontFamily="Segoe UI Black, Segoe UI" FontSize="24" FontWeight="Black" Foreground="#111111" />
                                    </Border>
                                    <TextBlock x:Name="NetCardHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="2,16,0,0"
                               Text="{x:Static loc:Resources.Settings_Overview_Hint}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Activity -->
            <ScrollViewer x:Name="PageActivity" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <v:ActivityView x:Name="ActivityPage" />
            </ScrollViewer>

            <!-- Microphone -->
            <ScrollViewer x:Name="PageMic" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static loc:Resources.ActivityDyn_DeviceName_Microphone}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_Shortcut}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <v:HotkeyRecorderBox x:Name="Recorder" Width="260" />
                                <Button Style="{StaticResource SubtleButton}" Content="{x:Static loc:Resources.Button_Reset}" Margin="8,0,0,0" Click="ResetHotkey_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="{x:Static loc:Resources.Settings_HotkeyRecorder_Hint}" />
                            <TextBlock x:Name="HotkeyWarning" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warning}" Visibility="Collapsed" />
                            <WrapPanel Margin="0,14,0,0">
                                <RadioButton x:Name="ModeToggle" Style="{StaticResource Segment}" GroupName="Mode" Content="{x:Static loc:Resources.Settings_Option_Toggle}" Checked="Mode_Changed" />
                                <RadioButton x:Name="ModePtt" Style="{StaticResource Segment}" GroupName="Mode" Content="{x:Static loc:Resources.Settings_Option_PushToTalk}" Checked="Mode_Changed" />
                            </WrapPanel>
                            <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_OnStart}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <WrapPanel>
                            <RadioButton x:Name="StartKeepLast" Style="{StaticResource Segment}" GroupName="OnStart" Content="{x:Static loc:Resources.Settings_Option_KeepLastState}" Checked="OnStart_Changed" />
                            <RadioButton x:Name="StartUnmuted" Style="{StaticResource Segment}" GroupName="OnStart" Content="{x:Static loc:Resources.Settings_Mic_OnStart_Unmuted}" Checked="OnStart_Changed" />
                            <RadioButton x:Name="StartMuted" Style="{StaticResource Segment}" GroupName="OnStart" Content="{x:Static loc:Resources.Settings_Mic_OnStart_Muted}" Checked="OnStart_Changed" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Mic_Devices_Title}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="DevAll" Style="{StaticResource Segment}" GroupName="Dev" Content="{x:Static loc:Resources.Settings_Option_AllMicrophones}" Checked="Devices_Changed" />
                                <RadioButton x:Name="DevSelected" Style="{StaticResource Segment}" GroupName="Dev" Content="{x:Static loc:Resources.Settings_Option_OnlySelected}" Checked="Devices_Changed" />
                            </WrapPanel>
                            <StackPanel x:Name="DeviceListPanel" Margin="0,12,0,0">
                                <ItemsControl x:Name="DeviceList" />
                                <TextBlock x:Name="NoDevicesText" Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Mic_NoDevices}" Visibility="Collapsed" />
                                <TextBlock x:Name="SelectNoneWarning" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Warning}" Visibility="Collapsed"
                                           Text="{x:Static loc:Resources.Settings_Mic_NoSelectionWarning}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <CheckBox x:Name="EnforceBox" Style="{StaticResource ToggleSwitch}" Checked="Enforce_Changed" Unchecked="Enforce_Changed">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Resources.Settings_Mic_EnforceMute_Title}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Mic_EnforceMute_Hint}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_TrayIcon}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="MicTrayBox" Style="{StaticResource ToggleSwitch}" Checked="MicTray_Changed" Unchecked="MicTray_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_Mic_Tray_Show}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Mic_Tray_Hint}" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="MicNoTrayWarning" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Visibility="Collapsed" Text="{x:Static loc:Resources.Settings_Mic_NoTrayWarning}" />
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="DoubleClickBox" Style="{StaticResource ToggleSwitch}" Checked="DoubleClick_Changed" Unchecked="DoubleClick_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_Mic_DoubleClick_Title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Mic_DoubleClick_Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_Alerts}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="MicNotifyBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_Mic_Notify_Title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Mic_Notify_Hint}" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="MicNotifyStylePanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Option_NotificationStyle}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="MicNotifyWindows" Style="{StaticResource Segment}" GroupName="MicNotifyStyle" Content="{x:Static loc:Resources.Settings_Option_WindowsNotification}" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="MicNotifyBadge" Style="{StaticResource Segment}" GroupName="MicNotifyStyle" Content="{x:Static loc:Resources.Settings_Option_CornerBadge}" Checked="Alerts_Changed" />
                                </WrapPanel>
                                <StackPanel x:Name="MicNotifyCornerPanel" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Option_BadgePosition}" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <RadioButton x:Name="MicNotifyCornerTL" Style="{StaticResource Segment}" GroupName="MicNotifyCorner" Content="{x:Static loc:Resources.Settings_Option_TopLeft}" Checked="Alerts_Changed" />
                                        <RadioButton x:Name="MicNotifyCornerTR" Style="{StaticResource Segment}" GroupName="MicNotifyCorner" Content="{x:Static loc:Resources.Settings_Option_TopRight}" Checked="Alerts_Changed" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox x:Name="MicOverlayBox" Style="{StaticResource ToggleSwitch}" Checked="Alerts_Changed" Unchecked="Alerts_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_Mic_Overlay_Title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Mic_Overlay_Hint}" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="MicCornerPanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Option_BadgePosition}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="MicCornerTL" Style="{StaticResource Segment}" GroupName="MicCorner" Content="{x:Static loc:Resources.Settings_Option_TopLeft}" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="MicCornerTR" Style="{StaticResource Segment}" GroupName="MicCorner" Content="{x:Static loc:Resources.Settings_Option_TopRight}" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="MicCornerBL" Style="{StaticResource Segment}" GroupName="MicCorner" Content="{x:Static loc:Resources.Settings_Option_BottomLeft}" Checked="Alerts_Changed" />
                                    <RadioButton x:Name="MicCornerBR" Style="{StaticResource Segment}" GroupName="MicCorner" Content="{x:Static loc:Resources.Settings_Option_BottomRight}" Checked="Alerts_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>                </StackPanel>
            </ScrollViewer>

            <!-- Camera -->
            <ScrollViewer x:Name="PageCamera" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static loc:Resources.ActivityDyn_DeviceName_Camera}" />

                    <Border x:Name="CamHelperBanner" Style="{StaticResource Card}" Padding="16,14" BorderBrush="{DynamicResource Warning}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Resources.Settings_Cam_HelperNotInstalled_Title}" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="{x:Static loc:Resources.Settings_Cam_HelperNotInstalled_Body}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_Shortcut}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <v:HotkeyRecorderBox x:Name="CamRecorder" Width="260" />
                                <Button Style="{StaticResource SubtleButton}" Content="{x:Static loc:Resources.Button_Reset}" Margin="8,0,0,0" Click="ResetCamHotkey_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="{x:Static loc:Resources.Settings_HotkeyRecorder_Hint}" />
                            <TextBlock x:Name="CamHotkeyWarning" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warning}" Visibility="Collapsed" />
                            <TextBlock x:Name="CamHotkeyHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_OnStart}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <WrapPanel>
                            <RadioButton x:Name="CamStartKeepLast" Style="{StaticResource Segment}" GroupName="CamOnStart" Content="{x:Static loc:Resources.Settings_Option_KeepLastState}" Checked="CamOnStart_Changed" />
                            <RadioButton x:Name="CamStartOn" Style="{StaticResource Segment}" GroupName="CamOnStart" Content="{x:Static loc:Resources.Settings_Cam_OnStart_On}" Checked="CamOnStart_Changed" />
                            <RadioButton x:Name="CamStartOff" Style="{StaticResource Segment}" GroupName="CamOnStart" Content="{x:Static loc:Resources.Settings_Cam_OnStart_Off}" Checked="CamOnStart_Changed" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Cam_Devices_Title}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="CamDevAll" Style="{StaticResource Segment}" GroupName="CamDev" Content="{x:Static loc:Resources.Settings_Cam_DevAll}" Checked="CamDevices_Changed" />
                                <RadioButton x:Name="CamDevSelected" Style="{StaticResource Segment}" GroupName="CamDev" Content="{x:Static loc:Resources.Settings_Option_OnlySelected}" Checked="CamDevices_Changed" />
                            </WrapPanel>
                            <StackPanel x:Name="CamListPanel" Margin="0,12,0,0">
                                <ItemsControl x:Name="CamList" />
                                <TextBlock x:Name="NoCamerasText" Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Cam_NoCameras}" Visibility="Collapsed" />
                                <TextBlock x:Name="CamSelectNoneWarning" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Warning}" Visibility="Collapsed"
                                           Text="{x:Static loc:Resources.Settings_Cam_NoSelectionWarning}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="CamEnforceBox" Style="{StaticResource ToggleSwitch}" Checked="CamEnforce_Changed" Unchecked="CamEnforce_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_Cam_EnforceOff_Title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Cam_EnforceOff_Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

