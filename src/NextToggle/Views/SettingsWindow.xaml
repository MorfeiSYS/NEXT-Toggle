                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_Net_Tray_Show}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Net_Tray_Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TaskbarSpeedSection" Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_TaskbarSpeed}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="TaskbarSpeedBox" Style="{StaticResource ToggleSwitch}" Checked="TaskbarSpeed_Changed" Unchecked="TaskbarSpeed_Changed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Resources.Settings_Net_TaskbarSpeed_Title}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Net_TaskbarSpeed_Hint}" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="TaskbarSpeedShowPanel" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static loc:Resources.Settings_Net_TaskbarSpeed_ShowLabel}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <RadioButton x:Name="TaskbarShowBoth" Style="{StaticResource Segment}" GroupName="TaskbarShow" Content="{x:Static loc:Resources.Settings_Net_TaskbarSpeed_Both}" Checked="TaskbarSpeed_Changed" />
                                    <RadioButton x:Name="TaskbarShowDown" Style="{StaticResource Segment}" GroupName="TaskbarShow" Content="{x:Static loc:Resources.Settings_Net_TaskbarSpeed_Down}" Checked="TaskbarSpeed_Changed" />
                                    <RadioButton x:Name="TaskbarShowUp" Style="{StaticResource Segment}" GroupName="TaskbarShow" Content="{x:Static loc:Resources.Settings_Net_TaskbarSpeed_Up}" Checked="TaskbarSpeed_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static loc:Resources.Settings_Section_Alerts}" />
